@model global::Cinema.ViewModels.CartVM

<div class="container my-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <h4 class="mb-3">Shopping Cart</h4>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info">Your cart is empty.</div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Movie</th>
                                <th>Price</th>
                                <th style="width:160px">Quantity</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(item.Image))
                                            {
                                                <img src="~/images/@item.Image" alt="@item.Name" style="width:50px;height:70px;object-fit:cover" class="me-2 rounded" />
                                            }
                                            <span>@item.Name</span>
                                        </div>
                                    </td>
                                    <td>@item.UnitPrice.ToString("C")</td>
                                    <td>
                                        <form asp-action="Update" method="post" class="d-flex">
                                            <input type="hidden" name="movieId" value="@item.MovieId" />
                                            <input type="number" name="count" value="@item.Count" min="0" max="10" class="form-control form-control-sm me-1" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                                        </form>
                                    </td>
                                    <td>@item.LineTotal.ToString("C")</td>
                                    <td>
                                        <form asp-action="Remove" method="post">
                                            <input type="hidden" name="movieId" value="@item.MovieId" />
                                            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="mb-3">Order Summary</h5>

                        @if (Model.PromoCode == null)
                        {
                            <form asp-action="ApplyPromo" method="post" class="d-flex mb-3">
                                <input type="text" name="code" class="form-control me-2" placeholder="Promo code" />
                                <button type="submit" class="btn btn-outline-secondary">Apply</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="RemovePromo" method="post" class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-success">@Model.PromoCode (-@Model.DiscountPercent%)</span>
                                <button type="submit" class="btn btn-sm btn-link text-danger">Remove</button>
                            </form>
                        }

                        <div class="d-flex justify-content-between">
                            <span>Subtotal (@Model.ItemsCount items)</span>
                            <span>@Model.SubTotal.ToString("C")</span>
                        </div>

                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between text-success">
                                <span>Discount</span>
                                <span>-@Model.DiscountAmount.ToString("C")</span>
                            </div>
                        }

                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Total</span>
                            <span>@Model.Total.ToString("C")</span>
                        </div>

                        <a asp-action="Checkout" class="btn btn-primary w-100 mt-3">Proceed to Checkout</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>