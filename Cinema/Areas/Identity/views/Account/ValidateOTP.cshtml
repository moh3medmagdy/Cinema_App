@model global::Cinema.ViewModels.ValidateOTPVM

<div class="row justify-content-center">
    <div class="col-md-4">
        <h2 class="text-center">Enter Code</h2>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-info">@TempData["Message"]</div>
        }

        <form asp-action="ValidateOTP" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="UserId" />

            <div class="mb-3">
                <label asp-for="OTP" class="form-label"></label>
                <input asp-for="OTP" class="form-control" maxlength="6" autocomplete="off" />
                <span asp-validation-for="OTP" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Verify</button>
        </form>

        <p class="text-center mt-2">
            <a asp-action="ForgetPassword">Resend code</a>
        </p>
    </div>
</div>
