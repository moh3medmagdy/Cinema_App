@model LoginVM

<div class="container mt-5" style="max-width:500px">
    <h2 class="text-center">Login</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">@TempData["Message"]</div>
    }

    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="UserNameOrEmail" class="form-label"></label>
            <input asp-for="UserNameOrEmail" class="form-control" />
            <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary w-100">Login</button>
    </form>

    <p class="text-center mt-3">
        Don't have an account? <a asp-action="Register">Register</a>
    </p>

    <p class="text-center mt-2">
        <a asp-action="ResendEmailConfirmation">Resend confirmation email</a> |
        <a asp-action="ForgetPassword">Forgot password?</a>
    </p>
</div>